# Copy to .env — the server reads this file directly (no dotenv dependency).
PORT=4000
JWT_SECRET=change-me-in-production
# Only emails on this domain may sign up as students.
UNIVERSITY_EMAIL_DOMAIN=utg.edu.gm
# MVP: no mail server. true = signup returns the verification token in the response
# so you can verify by hand / from the UI. Set false once real email is wired up.
DEV_RETURN_VERIFY_TOKEN=true
# Set true to skip the university-domain check while testing with gmail etc.
ALLOW_ANY_EMAIL=false
# Event/announcement posts wait in an admin queue before going live.
REQUIRE_POST_APPROVAL=true
# Rentals at or above this price (GMD) require a platform-held deposit.
DEPOSIT_THRESHOLD=1000
# Where the frontend runs (CORS allowlist, comma separated).
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
