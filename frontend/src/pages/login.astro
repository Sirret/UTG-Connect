---
import Base from '../layouts/Base.astro';
---

<Base title="Sign in">
  <h1 class="mb-1 text-lg font-semibold">Sign in</h1>
  <p class="mb-4 text-sm text-slate-500">Your university email, the one you verified at sign-up.</p>

  <form id="form" class="space-y-3 rounded-xl border border-slate-200 bg-white p-4">
    <input name="email" type="email" required placeholder="you@utg.edu.gm"
           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    <input name="password" type="password" required placeholder="Password"
           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    <button class="w-full rounded-lg bg-teal-700 px-4 py-2.5 text-sm font-medium text-white">Sign in</button>
    <p id="error" class="text-sm text-red-600"></p>
  </form>

  <p class="mt-3 text-center text-sm text-slate-500">
    New here? <a href="/signup" class="font-medium text-teal-700">Create an account</a>
  </p>

  <!-- Seeded demo logins, so the concept can be walked through without setup. -->
  <details class="mt-6 rounded-xl border border-slate-200 bg-white p-3 text-sm">
    <summary class="cursor-pointer font-medium">Demo accounts (seeded data)</summary>
    <p class="mt-2 text-xs text-slate-500">Every one uses the password <code class="rounded bg-slate-100 px-1">utgconnect1</code>. Click to fill.</p>
    <ul class="mt-2 space-y-1" id="demos"></ul>
  </details>

  <script>
    import { post, auth } from '../lib/api.js';
    import { $, esc } from '../lib/ui.js';

    const demos = [
      ['fatou.jallow@utg.edu.gm', 'Student & seller — listings, offers, followers'],
      ['binta.camara@utg.edu.gm', 'Student buyer — open rental with a held deposit'],
      ['itca.council@utg.edu.gm', 'ITCA council — can post to ITCA only'],
      ['admin@utg.edu.gm', 'Admin — approval queue, disputes, ban list'],
    ];
    $('#demos').innerHTML = demos
      .map(
        ([email, note]) =>
          `<li><button data-email="${esc(email)}" class="demo text-left text-teal-700 hover:underline">${esc(email)}</button> <span class="text-xs text-slate-500">— ${esc(note)}</span></li>`,
      )
      .join('');
    document.querySelectorAll('.demo').forEach((b) =>
      b.addEventListener('click', () => {
        $('[name=email]').value = b.dataset.email;
        $('[name=password]').value = 'utgconnect1';
      }),
    );

    $('#form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('#error').textContent = '';
      const data = Object.fromEntries(new FormData(e.target));
      try {
        const res = await post('/auth/login', data);
        auth.signIn(res.token, { ...res.user, email: data.email });
        location.href = res.user.role === 'admin' ? '/admin' : '/';
      } catch (err) {
        // Unverified accounts get a one-click path forward in the MVP, since
        // there is no mail server wired up yet.
        if (err.payload?.needsVerification && err.payload?.verifyToken) {
          const res = await post('/auth/verify', { token: err.payload.verifyToken });
          auth.signIn(res.token, { ...res.user, email: data.email });
          location.href = '/';
          return;
        }
        $('#error').textContent = err.message;
      }
    });
  </script>
</Base>
