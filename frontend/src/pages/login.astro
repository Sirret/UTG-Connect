---
import Base from '../layouts/Base.astro';
import AuthScene from '../components/AuthScene.astro';
import { withBase } from '../lib/ui.js';
---

<Base title="Sign in" full>
  <div class="grid min-h-dvh grid-cols-1 sm:grid-cols-[1.1fr_minmax(380px,0.9fr)]">
    <AuthScene heading="One campus. One place for all of it." />

    <div class="flex items-center justify-center px-5 py-10 sm:px-10">
      <div class="w-full max-w-sm">
        <h1 class="text-[26px] font-extrabold tracking-tight text-navy-deep">Sign in</h1>
        <svg width="72" height="8" viewBox="0 0 72 8" class="my-2" aria-hidden="true">
          <path
            d="M1 7 L7 1.5 L13 7 L19 1.5 L25 7 L31 1.5 L37 7 L43 1.5 L49 7 L55 1.5 L61 7 L67 1.5 L72 7"
            fill="none"
            stroke="#EB3F28"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        </svg>
        <p class="mb-5 text-sm text-slate-600">Use your university email — the one you verified at sign-up.</p>

        <form id="form" class="space-y-3">
          <input name="email" type="email" required placeholder="you@utg.edu.gm"
                 class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm" />
          <input name="password" type="password" required placeholder="Password"
                 class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm" />
          <button class="w-full rounded-lg bg-navy px-4 py-2.5 text-sm font-semibold text-white hover:bg-navy-deep">Sign in</button>
          <p id="error" class="text-sm text-red-600"></p>
        </form>

        <p class="mt-3 text-center text-sm text-slate-500">
          New here? <a href={withBase('/signup')} class="font-semibold text-navy">Create an account</a>
        </p>

        <!-- Seeded demo logins, so the concept can be walked through without setup. -->
        <div class="mt-8 border-t border-dashed border-slate-300 pt-5">
          <p class="text-xs font-semibold text-slate-500">Try a demo account (seeded data)</p>
          <p class="mt-1 text-xs text-slate-400">
            Every one uses the password <code class="rounded bg-slate-100 px-1 py-0.5 text-slate-600">utgconnect1</code>.
          </p>
          <div id="demos" class="mt-3 grid grid-cols-2 gap-2"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { post, auth } from '../lib/api.js';
    import { $, esc, withBase } from '../lib/ui.js';

    const demos = [
      ['fatou.jallow@utg.edu.gm', 'Fatou', 'Student & seller'],
      ['binta.camara@utg.edu.gm', 'Binta', 'Student buyer'],
      ['itca.council@utg.edu.gm', 'ITCA', 'Council account'],
      ['admin@utg.edu.gm', 'Admin', 'Platform admin'],
    ];
    const initials = (name) => name.slice(0, 2).toUpperCase();

    $('#demos').innerHTML = demos
      .map(
        ([email, name, note]) => `
      <button data-email="${esc(email)}" class="demo flex flex-col items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 text-center hover:border-navy">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-teal-50 text-[11px] font-bold text-navy">${esc(initials(name))}</span>
        <span class="text-xs font-semibold leading-tight">${esc(name)}</span>
        <span class="text-[10px] leading-tight text-slate-400">${esc(note)}</span>
      </button>`,
      )
      .join('');
    document.querySelectorAll('.demo').forEach((b) =>
      b.addEventListener('click', () => {
        $('[name=email]').value = b.dataset.email;
        $('[name=password]').value = 'utgconnect1';
      }),
    );

    $('#form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('#error').textContent = '';
      const data = Object.fromEntries(new FormData(e.target));
      try {
        const res = await post('/auth/login', data);
        auth.signIn(res.token, { ...res.user, email: data.email });
        location.href = withBase(res.user.role === 'admin' ? '/admin' : '/');
      } catch (err) {
        // Unverified accounts get a one-click path forward in the MVP, since
        // there is no mail server wired up yet.
        if (err.payload?.needsVerification && err.payload?.verifyToken) {
          const res = await post('/auth/verify', { token: err.payload.verifyToken });
          auth.signIn(res.token, { ...res.user, email: data.email });
          location.href = withBase('/');
          return;
        }
        $('#error').textContent = err.message;
      }
    });
  </script>
</Base>
