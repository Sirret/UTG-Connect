---
import Base from '../layouts/Base.astro';
---

<Base title="Seller" active="market">
  <div id="view"></div>

  <script>
    import { fetchJson, post, auth } from '../lib/api.js';
    import { $, esc, money, qs, spinner, toast, empty } from '../lib/ui.js';

    const username = qs('u');
    const me = auth.user;

    async function render() {
      $('#view').innerHTML = spinner();
      const { seller: s, listings, reviews } = await fetchJson(`/sellers/${username}`);

      $('#view').innerHTML = `
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class="flex items-center gap-3">
            ${s.avatarUrl ? `<img src="${esc(s.avatarUrl)}" alt="" width="56" height="56" class="h-14 w-14 rounded-full object-cover" />` : '<span class="h-14 w-14 rounded-full bg-slate-200"></span>'}
            <div class="min-w-0 flex-1">
              <h1 class="truncate font-semibold">${esc(s.name)}</h1>
              <p class="text-sm text-slate-500">@${esc(s.username)}${s.school ? ` · ${esc(s.school.code)}` : ''}</p>
            </div>
            ${
              me && me.username !== s.username
                ? `<button id="follow" class="rounded-lg px-3 py-1.5 text-sm font-medium ${s.following ? 'border border-slate-300' : 'bg-teal-700 text-white'}">${s.following ? 'Following' : 'Follow'}</button>`
                : ''
            }
          </div>

          ${s.bio ? `<p class="mt-3 text-sm text-slate-700">${esc(s.bio)}</p>` : ''}

          <div class="mt-3 flex flex-wrap gap-1.5">
            ${s.badges
              .map(
                (b) => `<span title="${esc(b.note)}" class="rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-800 ring-1 ring-inset ring-teal-200">${esc(b.label)}</span>`,
              )
              .join('')}
            ${s.banned ? '<span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Banned</span>' : ''}
          </div>

          <div class="mt-3 grid grid-cols-3 gap-2 text-center text-sm">
            <div class="rounded-lg bg-slate-50 py-2"><p class="font-semibold">${s.rating ?? '—'}${s.rating ? '★' : ''}</p><p class="text-xs text-slate-500">${s.ratingCount} rating${s.ratingCount === 1 ? '' : 's'}</p></div>
            <div class="rounded-lg bg-slate-50 py-2"><p class="font-semibold">${s.deals}</p><p class="text-xs text-slate-500">deals done</p></div>
            <div class="rounded-lg bg-slate-50 py-2"><p class="font-semibold">${s.followers}</p><p class="text-xs text-slate-500">followers</p></div>
          </div>

          <p class="mt-2 text-xs text-slate-500">${esc(s.responseTime)}</p>
        </div>

        <h2 class="mb-2 mt-5 text-sm font-medium text-slate-600">Active listings</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          ${
            listings.length
              ? listings
                  .map(
                    (l) => `
            <a href="/listing?id=${l.id}" class="overflow-hidden rounded-xl border border-slate-200 bg-white">
              <img src="${esc(l.imageUrl)}" alt="${esc(l.title)}" loading="lazy" width="300" height="300" class="aspect-square w-full object-cover" />
              <div class="p-2">
                <p class="line-clamp-2 text-sm leading-snug">${esc(l.title)}</p>
                <p class="mt-1 text-sm font-semibold text-teal-700">${esc(money(l.price, l.currency, l.priceUnit))}</p>
              </div>
            </a>`,
                  )
                  .join('')
              : `<div class="col-span-full">${empty('Nothing listed right now.')}</div>`
          }
        </div>

        ${
          reviews.length
            ? `<h2 class="mb-2 mt-5 text-sm font-medium text-slate-600">Reviews</h2>
               <ul class="space-y-2">
                 ${reviews
                   .map(
                     (r) => `<li class="rounded-lg border border-slate-200 bg-white p-3 text-sm">
                       <p class="font-medium">${'★'.repeat(r.stars)}<span class="text-slate-300">${'★'.repeat(5 - r.stars)}</span> <span class="text-slate-500">${esc(r.by)}</span></p>
                       ${r.comment ? `<p class="mt-1 text-slate-600">${esc(r.comment)}</p>` : ''}
                     </li>`,
                   )
                   .join('')}
               </ul>`
            : ''
        }`;

      $('#follow')?.addEventListener('click', async (e) => {
        const { following } = await post(`/sellers/${username}/follow`);
        e.target.textContent = following ? 'Following' : 'Follow';
        e.target.className = `rounded-lg px-3 py-1.5 text-sm font-medium ${following ? 'border border-slate-300' : 'bg-teal-700 text-white'}`;
        toast(following ? 'You will be told when they post or restock.' : 'Unfollowed.');
      });
    }

    render().catch((e) => {
      $('#view').innerHTML = `<p class="py-8 text-center text-sm text-red-600">${esc(e.message)}</p>`;
    });
  </script>
</Base>
