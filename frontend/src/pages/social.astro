---
import Base from '../layouts/Base.astro';
---

<Base title="Social" active="social">
  <div class="mb-4 flex items-center justify-between gap-2">
    <div>
      <h1 class="text-lg font-extrabold text-navy-deep">Social</h1>
      <p class="text-xs text-slate-500">Whatever's happening on campus — not just the official stuff.</p>
    </div>
    <button id="new-post" class="shrink-0 rounded-lg bg-navy px-3 py-1.5 text-sm font-semibold text-white hover:bg-navy-deep">New post</button>
  </div>

  <form id="compose" class="mb-4 hidden space-y-2 rounded-2xl border border-slate-200 bg-white p-3.5">
    <textarea name="caption" rows="2" placeholder="Say something about it…" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
    <input type="file" id="photo-input" accept="image/*" required class="block w-full text-sm" />
    <div id="photo-preview" class="hidden">
      <img class="h-28 w-28 rounded-lg border border-slate-200 object-cover" alt="" />
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <button type="button" id="cancel-post" class="rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-500">Cancel</button>
      <button class="rounded-lg bg-navy px-4 py-1.5 text-sm font-semibold text-white">Share</button>
    </div>
    <p id="compose-error" class="text-xs text-brand-red-deep"></p>
  </form>

  <div id="feed" class="space-y-4"></div>

  <script>
    import { get, post, del, fetchJson, auth, upload, invalidate } from '../lib/api.js';
    import { $, esc, relative, spinner, empty, toast, heartIcon, SHARE_ICON, COMMENT_ICON, withBase } from '../lib/ui.js';

    const user = auth.user;
    if (!user) location.href = withBase('/login');

    const initials = (name) =>
      (name || '')
        .trim()
        .split(/\s+/)
        .map((w) => w[0])
        .slice(0, 2)
        .join('')
        .toUpperCase();

    function card(p) {
      const canDelete = user && (user.id === p.author.id || user.role === 'admin');
      return `
      <article id="social-${p.id}" class="overflow-hidden rounded-2xl border border-slate-200 bg-white" data-id="${p.id}">
        <div class="flex items-center gap-2.5 px-3.5 pb-2.5 pt-3.5">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-navy text-xs font-bold text-white">${esc(initials(p.author.name))}</span>
          <div class="min-w-0 flex-1">
            <span class="block truncate text-sm font-bold text-slate-900">${esc(p.author.name)}</span>
            <span class="block text-xs text-slate-400">${esc(relative(p.createdAt))}</span>
          </div>
          ${canDelete ? `<button class="delete-post shrink-0 text-xs font-semibold text-slate-400 hover:text-brand-red" data-id="${p.id}">Delete</button>` : ''}
        </div>
        <div class="aspect-square bg-slate-100">
          <img src="${esc(p.imageUrl)}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </div>
        <div class="p-3.5">
          <div class="flex items-center gap-4">
            <button class="like-btn flex h-6 w-6 items-center justify-center ${p.liked ? 'text-brand-red' : 'text-slate-600 hover:text-slate-900'}" data-id="${p.id}" aria-label="Like">${heartIcon(p.liked)}</button>
            <button class="comment-toggle flex h-6 w-6 items-center justify-center text-slate-600 hover:text-slate-900" data-id="${p.id}" aria-label="Comments">${COMMENT_ICON}</button>
            <button class="share-btn flex h-6 w-6 items-center justify-center text-slate-600 hover:text-slate-900" data-id="${p.id}" aria-label="Share">${SHARE_ICON}</button>
          </div>
          <p class="mt-2 text-sm font-bold text-slate-900" data-likes data-count="${p.likeCount}">${p.likeCount} like${p.likeCount === 1 ? '' : 's'}</p>
          ${p.caption ? `<p class="mt-0.5 text-sm text-slate-700"><span class="font-bold">${esc(p.author.name)}</span> ${esc(p.caption)}</p>` : ''}
          <button class="comment-toggle mt-1 block text-xs text-slate-400" data-id="${p.id}">${p.commentCount ? `View all ${p.commentCount} comments` : 'Add a comment'}</button>
          <div class="comments mt-2 hidden"></div>
        </div>
      </article>`;
    }

    async function renderFeed() {
      $('#feed').innerHTML = spinner();
      const { data } = await get('/social?limit=40');
      $('#feed').innerHTML = data.posts.length ? data.posts.map(card).join('') : empty('Nothing here yet — be the first to post.');
    }

    async function loadComments(id, host) {
      host.innerHTML = spinner('Loading comments…');
      const { comments } = await fetchJson(`/social/${id}/comments`);
      host.innerHTML = `
        <div class="list space-y-1.5">
          ${comments.map((c) => `<p class="text-sm"><span class="font-bold">${esc(c.author.name)}</span> ${esc(c.body)}</p>`).join('') || '<p class="text-xs text-slate-400">No comments yet.</p>'}
        </div>
        ${
          user
            ? `<form class="add-comment mt-2 flex gap-2">
                 <input name="body" placeholder="Add a comment…" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs" />
                 <button class="shrink-0 rounded-lg bg-navy px-3 py-1.5 text-xs font-semibold text-white">Post</button>
               </form>`
            : `<a href="${withBase('/login')}" class="mt-2 block text-xs font-semibold text-navy">Sign in to comment</a>`
        }`;

      host.querySelector('.add-comment')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = e.target.elements.body;
        const body = input.value.trim();
        if (!body) return;
        const { comment } = await post(`/social/${id}/comments`, { body });
        input.value = '';
        host.querySelector('.list').insertAdjacentHTML(
          'beforeend',
          `<p class="text-sm"><span class="font-bold">${esc(comment.author.name)}</span> ${esc(comment.body)}</p>`,
        );
      });
    }

    $('#feed').addEventListener('click', async (e) => {
      const like = e.target.closest('.like-btn');
      if (like) {
        if (!user) {
          toast('Sign in to like posts');
          return;
        }
        const { liked } = await post(`/social/${like.dataset.id}/like`);
        like.innerHTML = heartIcon(liked);
        like.className = `like-btn flex h-6 w-6 items-center justify-center ${liked ? 'text-brand-red' : 'text-slate-600 hover:text-slate-900'}`;
        const likesEl = like.closest('article').querySelector('[data-likes]');
        const n = Number(likesEl.dataset.count) + (liked ? 1 : -1);
        likesEl.dataset.count = n;
        likesEl.textContent = `${n} like${n === 1 ? '' : 's'}`;
        return;
      }

      const toggle = e.target.closest('.comment-toggle');
      if (toggle) {
        const box = toggle.closest('article').querySelector('.comments');
        const wasHidden = box.classList.contains('hidden');
        box.classList.toggle('hidden');
        if (wasHidden && !box.dataset.loaded) {
          box.dataset.loaded = '1';
          loadComments(toggle.dataset.id, box);
        }
        return;
      }

      const share = e.target.closest('.share-btn');
      if (share) {
        const url = `${location.origin}${withBase('/social')}#social-${share.dataset.id}`;
        if (navigator.share) {
          navigator.share({ url }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(() => toast('Link copied'));
        }
        return;
      }

      const remove = e.target.closest('.delete-post');
      if (remove && confirm('Delete this post?')) {
        await del(`/social/${remove.dataset.id}`);
        invalidate('/social');
        remove.closest('article').remove();
        toast('Post deleted');
      }
    });

    $('#new-post').addEventListener('click', () => {
      if (!user) {
        location.href = withBase('/login');
        return;
      }
      $('#compose').classList.toggle('hidden');
    });
    $('#cancel-post').addEventListener('click', () => $('#compose').classList.add('hidden'));

    let imageUrl = null;
    $('#photo-input').addEventListener('change', async () => {
      const file = $('#photo-input').files[0];
      if (!file) return;
      try {
        const res = await upload(file);
        imageUrl = res.url;
        $('#photo-preview').classList.remove('hidden');
        $('#photo-preview img').src = imageUrl;
      } catch (err) {
        toast(err.message, 'error');
      }
    });

    $('#compose').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('#compose-error').textContent = '';
      if (!imageUrl) {
        $('#compose-error').textContent = 'Add a photo first.';
        return;
      }
      const f = new FormData(e.target);
      try {
        await post('/social', { caption: f.get('caption') || '', imageUrl });
        e.target.reset();
        imageUrl = null;
        $('#photo-preview').classList.add('hidden');
        $('#compose').classList.add('hidden');
        invalidate('/social');
        toast('Posted!');
        renderFeed();
      } catch (err) {
        $('#compose-error').textContent = err.message;
      }
    });

    renderFeed();
  </script>
</Base>
